{
  "definitions": {
    "central_conc_mg_L": "central_pos_mg / max(V1_L, 1.0e-12)",
    "central_pos_mg": "max(central_mg, 0.0)",
    "death_stimulation_fraction": "Emax * central_conc_mg_L / max(EC50_KD_mg_L + central_conc_mg_L, 1.0e-12)",
    "distribution_mg_h": "Q_L_h * (central_conc_mg_L - peripheral_conc_mg_L)",
    "drug_inhibition_fraction": "Emax * central_conc_mg_L / max(EC50_Kio_mg_L + central_conc_mg_L, 1.0e-12)",
    "linear_clearance_mg_h": "CL_L_h * central_conc_mg_L",
    "nonlinear_clearance_mg_h": "Vmax_mg_h * central_conc_mg_L / max(Km_mg_L + central_conc_mg_L, 1.0e-12)",
    "peripheral_conc_mg_L": "peripheral_pos_mg / max(V2_L, 1.0e-12)",
    "peripheral_pos_mg": "max(peripheral_mg, 0.0)",
    "progression_multiplier": "1.0 + progression_factor_1_week * elapsed_h / 168.0",
    "receptor_occupancy_percent": "100.0 * central_conc_mg_L / max(Km_mg_L + central_conc_mg_L, 1.0e-12)",
    "target_mediated_clearance_fraction": "nonlinear_clearance_mg_h / max(total_clearance_mg_h, 1.0e-12)",
    "total_clearance_mg_h": "linear_clearance_mg_h + nonlinear_clearance_mg_h",
    "tumor_death_rate_mm3_h": "KD_1_h + drug_stimulated_death_scale * KD_1_h * death_stimulation_fraction * tumor_pos_mm3",
    "tumor_growth_rate_mm3_h": "KG_mm3_h * progression_multiplier * growth_effect",
    "tumor_pos_mm3": "max(tumor_mm3, 0.0)"
  },
