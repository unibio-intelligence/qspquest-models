{"model_id":"qspquest-besbassi-2026-crs-qsp-locked-cytokine-network","external_inputs":{},"definitions":{"safe_Cdrug_nM":"max(Cdrug_nM, 0.0)","drug_input_nM_h":"infusion_mg_h * 1000000.0 / max(drug_mw_da * Vcentral_L, 1.0e-12)","fact":"safe_Cdrug_nM**nH / max(EC50_act_nM**nH + safe_Cdrug_nM**nH, 1.0e-12)","mac_signal_pg_ml":"max(IFNg_pg_ml, 0.0) + max(TNFa_pg_ml, 0.0)","fmac":"mac_signal_pg_ml / max(EC50_mac_pg_ml + mac_signal_pg_ml, 1.0e-12)","macpool_eff":"macpool_cells_ul_equiv * (1.0 + kmac_recruit * mac_signal_pg_ml / max(Km_recruit_pg_ml + mac_signal_pg_ml, 1.0e-12))","fIL10":"1.0 / (1.0 + max(IL10_pg_ml, 0.0) / max(IC50_IL10_pg_ml, 1.0e-12))","tocilizumab_active":"tocilizumab_enabled * (t >= tocilizumab_start_h)","jfeedback_raw":"kfb_h * max(IL6_pg_ml - IL6_baseline_pg_ml, 0.0) * max(IL6_pg_ml, 0.0) / max(Km_fb_pg_ml + max(IL6_pg_ml, 0.0), 1.0e-12) * fmac","jfeedback_effective":"(1.0 - tocilizumab_active) * jfeedback_raw","kdeg_IL6_effective_h":"kdeg_IL6_h * (1.0 - 0.7 * tocilizumab_active)","current_crs_grade":"(IL6_pg_ml > 30.0) + (IL6_pg_ml > 200.0) + (IL6_pg_ml > 1000.0) + (IL6_pg_ml > 5000.0)"},"equations":{"Cdrug_nM":"drug_input_nM_h - (CL_L_h / max(Vcentral_L, 1.0e-12)) * Cdrug_nM","Trest_cells_ul":"-kact_h * fact * Trest_cells_ul","Tact_cells_ul":"kact_h * fact * Trest_cells_ul + kprolif_h * Tact_cells_ul * (1.0 - (Tact_cells_ul + Tcyt_cells_ul) / max(Tact_max_cells_ul, 1.0e-12)) - kdiff_h * Tact_cells_ul - kexhaust_h * Tact_cells_ul","Tcyt_cells_ul":"kdiff_h * Tact_cells_ul - kexhaust_h * Tcyt_cells_ul","Texh_cells_ul":"kexhaust_h * (Tact_cells_ul + Tcyt_cells_ul)","IFNg_pg_ml":"kprod_IFNg_pg_ml_h_per_cell_ul * Tcyt_cells_ul * fIL10 - kdeg_IFNg_h * IFNg_pg_ml","TNFa_pg_ml":"kprod_TNFa_pg_ml_h_per_cell_ul * Tcyt_cells_ul * fIL10 - kdeg_TNFa_h * TNFa_pg_ml","IL6_pg_ml":"kprod_IL6_mac_pg_ml_h_per_cell_ul * fmac * macpool_eff * fIL10 + jfeedback_effective - kdeg_IL6_effective_h * IL6_pg_ml","IL1b_pg_ml":"kprod_IL1b_mac_pg_ml_h_per_cell_ul * fmac * macpoo