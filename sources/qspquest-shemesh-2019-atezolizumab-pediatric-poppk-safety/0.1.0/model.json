{"id":"qspquest-shemesh-2019-atezolizumab-pediatric-poppk-safety","version":"0.1.0","name":"Shemesh 2019 Atezolizumab Pediatric and Young Adult PopPK/Safety Model","description":"Deterministic implementation of the published Shemesh 2019 pediatric/young-adult two-compartment IV-infusion PopPK fixed effects and covariate equations, with exact Tables 1-3 anchors, Figure 2 dynamic comparisons, and separate digitized population/safety diagnostics.","states":{"A_central_mg":{"name":"Central atezolizumab amount","default":0.0,"unit":"mg"},"A_peripheral_mg":{"name":"Peripheral atezolizumab amount","default":0.0,"unit":"mg"},"AUC_ug_day_mL":{"name":"Cumulative central concentration AUC","default":0.0,"unit":"ug*day/mL"},"elapsed_time_day":{"name":"Elapsed time","default":0.0,"unit":"day"}},"parameters":{"CL_ref_L_day":{"name":"Reference clearance","default":0.217,"unit":"L/day","category":"Table 2 fixed effect"},"V1_ref_L":{"name":"Reference central volume","default":3.01,"unit":"L","category":"Table 2 fixed effect"},"V2_ref_L":{"name":"Reference peripheral volume","default":1.36,"unit":"L","category":"Table 2 fixed effect"},"Q_L_day":{"name":"Intercompartmental clearance","default":0.183,"unit":"L/day","category":"Table 2 fixed effect"},"body_weight_kg":{"name":"Body weight","default":38.9,"unit":"kg","category":"Covariate"},"body_weight_ref_kg":{"name":"Reference body weight","default":77.0,"unit":"kg","category":"Covariate"},"albumin_g_L":{"name":"Albumin","default":40.0,"unit":"g/L","category":"Covariate"},"albumin_ref_g_L":{"name":"Reference albumin","default":40.0,"unit":"g/L","category":"Covariate"},"tumor_burden_mm":{"name":"Tumor burden","default":63.0,"unit":"mm","category":"Covariate"},"tumor_ref_mm":{"name":"Reference tumor burden","default":63.0,"unit":"mm","category":"Covariate"},"ada_positive":{"name":"ADA-positive indicator","default":0.0,"unit":"0/1","category":"Covariate"},"theta_weight_CL":{"name":"Weight exponent on CL","default":0.795,"unit":"dimensionless","category":"Table 2 covariate"},"theta_albumin_CL":{"name":"Albumin exponent on CL","default":-1.18,"unit":"dimensionless","category":"Table 2 covariate"},"theta_tumor_CL":{"name":"Tumor burden exponent on CL","default":0.122,"unit":"dimensionless","category":"Table 2 covariate"},"theta_ada_CL":{"name":"ADA multiplier on CL","default":1.23,"unit":"fold","category":"Table 2 covariate"},"theta_weight_V1":{"name":"Weight exponent on V1","default":0.766,"unit":"dimensionless","category":"Table 2 covariate"},"theta_albumin_V1":{"name":"Albumin exponent on V1","default":-0.566,"unit":"dimensionless","category":"Table 2 covariate"},"dose_to_central_fraction":{"name":"Dose routed to central","default":1.0,"unit":"fraction","category":"runtime"},"target_trough_ug_mL":{"name":"target trough ug mL","default":6.0,"unit":"ug/mL","category":"Exact source scalar","description":"Preclinical-derived 6 ug/mL concentration benchmark. Instantaneous flag is not efficacy, cycle1 trough, or population target-attainment probability."}},"dosing_targets":{"A_central_mg":"dose_to_central_fraction"},"solver":{"method":"Tsit5","abstol":1e-11,"reltol":1e-10,"maxiters":1000000},"source":{"doi":"10.1186/s40425-019-0791-x","url":"https://doi.org/10.1186/s40425-019-0791-x","license":"CC BY 4.0","license_url":"https://creativecommons.org/licenses/by/4.0/","paper_title":"Shemesh 2019 Atezolizumab Pediatric and Young Adult PopPK/Safety Model"}}
