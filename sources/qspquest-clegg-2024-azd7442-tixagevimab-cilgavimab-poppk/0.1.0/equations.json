{"model_id":"qspquest-clegg-2024-azd7442-tixagevimab-cilgavimab-poppk","external_inputs":{},"definitions":{"weight_ratio":"max(body_weight_kg, 1.0) / reference_weight_kg","ka_eff_1_day":"ka_1_day * exp(beta_ka_male * is_male + beta_ka_age_over65 * is_age_over65 + beta_ka_bmi_ge30 * is_bmi_ge30 + beta_ka_diabetes * has_diabetes)","cl_eff_l_day":"cl_l_day * weight_ratio**0.75 * exp(beta_cl_diabetes * has_diabetes)","vc_eff_l":"vc_l * weight_ratio * exp(beta_vc_black * is_black_race)","q_eff_l_day":"q_l_day * weight_ratio**0.75","vp_eff_l":"vp_l * weight_ratio","fim_eff":"fim_fraction * exp(beta_fim_thigh * is_thigh_injection)","central_conc_ug_ml_calc":"A_central_mg / max(vc_eff_l, 1.0e-12)","peripheral_conc_ug_ml_calc":"A_peripheral_mg / max(vp_eff_l, 1.0e-12)","absorption_mg_day":"fim_eff * ka_eff_1_day * A_depot_mg","elimination_mg_day":"cl_eff_l_day * central_conc_ug_ml_calc","central_to_peripheral_mg_day":"q_eff_l_day * central_conc_ug_ml_calc","peripheral_to_central_mg_day":"q_eff_l_day * peripheral_conc_ug_ml_calc","k10_day":"cl_eff_l_day / max(vc_eff_l, 1.0e-12)","k12_day":"q_eff_l_day / max(vc_eff_l, 1.0e-12)","k21_day":"q_eff_l_day / max(vp_eff_l, 1.0e-12)","lambda_z_day":"0.5 * ((k10_day + k12_day + k21_day) - sqrt(max((k10_day + k12_day + k21_day)**2 - 4.0 * k10_day * k21_day, 1.0e-18)))","typical_terminal_half_life_day_calc":"log(2.0) / max(lambda_z_day, 1.0e-12)","cavg_cum_ug_ml_calc":"AUC_ug_day_ml / max(elapsed_time_day, 1.0e-12)"},"equations":{"A_depot_mg":"-ka_eff_1_day * A_depot_mg","A_central_mg":"Dose_rate_ab + absorption_mg_day - elimination_mg_day - central_to_peripheral_mg_day + peripheral_to_central_mg_day","A_peripheral_mg":"central_to_peripheral_mg_day - peripheral_to_central_mg_day","AUC_ug_day_ml":"central_conc_ug_ml_calc","elapsed_time_day":"1.0"},"derived_outputs":{"central_conc_ug_ml":"A_central_mg / max(vc_eff_l, 1.0e-12)","peripheral_conc_ug_ml":"A_peripheral_mg / max(vp_eff_l, 1.0e-12)","AUC_ug_day_ml":"AUC_ug_day_ml","Cavg_cum_ug_ml":"cavg_cum_ug_ml_calc","ka_eff_1_day":"ka_eff_1_day","cl_eff_l_day":"cl_eff_l_day","vc_eff_l":"vc_eff_l","q_eff_l_day":"q_eff_l_day","vp_eff_l":"vp_eff_l","fim_eff":"fim_eff","typical_terminal_half_life_day":"typical_terminal_half_life_day_calc","elapsed_time_day":"elapsed_time_day"}}
