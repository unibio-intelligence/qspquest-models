    "free_tfpi_ng_mL_joint_observation": "in_vivo_tfpi_baseline_ng_mL * free_tfpi_percent_joint_observation / 100.0",
    "free_tfpi_percent_baseline": "100.0 * free_tfpi_nM / max(baseline_tfpi_nM, 1e-12)",
    "free_tfpi_percent_joint_observation": "invitro_tfpi_bottom_percent + (invitro_tfpi_top_percent - invitro_tfpi_bottom_percent) / (1.0 + (max(central_free_nM, 0.0) / max(invitro_free_tfpi_ic50_nM, 1e-12)) ** invitro_tfpi_hill)",
    "invitro_dpt_clotting_time_sec_response": "invitro_dpt_bottom_sec + (invitro_dpt_top_sec - invitro_dpt_bottom_sec) / (1.0 + (max(invitro_probe_concentration_nM, 0.0) / max(invitro_dpt_ic50_nM, 1e-12)) ** invitro_dpt_hill)",
    "invitro_free_tfpi_percent_response": "invitro_tfpi_bottom_percent + (invitro_tfpi_top_percent - invitro_tfpi_bottom_percent) / (1.0 + (max(invitro_probe_concentration_nM, 0.0) / max(invitro_free_tfpi_ic50_nM, 1e-12)) ** invitro_tfpi_hill)",
