    "peripheral_free_nM": "max(peripheral_free_nmol_kg, 0.0) / vt_L_kg",
    "sc_absorption_nmol_h_kg": "sc_fast_ka_h * max(sc_fast_depot_nmol_kg, 0.0) + sc_slow_ka2_h * max(sc_slow_transit_nmol_kg, 0.0)",
