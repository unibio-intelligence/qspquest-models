{"id":"qspquest-brekkan-2024-certolizumab-ada-hidden-markov","version":"0.1.0","name":"Brekkan 2024 certolizumab ADA bivariate hidden-Markov model","description":"Source-complete, patient-data-limited reconstruction of the final Brekkan et al. bivariate mixed hidden-Markov model for certolizumab anti-drug-antibody dynamics. The runtime represents the two hidden ADA-production states as a continuous-time probability ODE calibrated to the paper-reported Model 6 mean first transition time, while exact scenarios replay the article and SI parameter estimates.","time_unit":"day","states":{"p_noada":{"name":"Probability of no ADA production state","default":1,"unit":"probability","description":"Continuous-time probability proxy for hidden state SNOADA."},"p_ada":{"name":"Probability of ADA production state","default":0,"unit":"probability","description":"Continuous-time probability proxy for hidden state SADA."},"first_transition_survival":{"name":"Not-yet-transitioned survival probability","default":1,"unit":"probability","description":"Probability that the first transition from SNOADA to SADA has not occurred."},"elapsed_day":{"name":"Elapsed simulation time","default":0,"unit":"day","description":"Clock state for dynamic overlays."},"summary_marker":{"name":"Summary marker","default":1,"unit":"dimensionless","description":"Static marker used by exact table-replay scenarios."}},"parameters":{"model6_pkres_snoada":{"name":"Model 6 PKRES in SNOADA","default":0.3,"unit":"weighted residual","category":"Table 3"},"model6_pkres_sada":{"name":"Model 6 PKRES in SADA","default":-1.6,"unit":"weighted residual","category":"Table 3"},"model6_adames_snoada_u_ml":{"name":"Model 6 ADA measurement in SNOADA","default":0.6,"unit":"U/mL","category":"Table 3 fixed"},"model6_adames_sada_u_ml":{"name":"Model 6 ADA measurement in SADA","default":2.4,"unit":"U/mL","category":"Table 3 fixed"},"model6_sigma2_pkres":{"name":"Model 6 PKRES variance","default":0.8,"unit":"weighted residual^2","category":"Table 3"},"model6_sigma2_adames":{"name":"Model 6 ADA variance","default":1.6,"unit":"(U/mL)^2","category":"Table 3"},"model6_rho_snoada":{"name":"Model 6 correlation in SNOADA","default":-0.1,"unit":"correlation","category":"Table 3"},"model6_rho_sada":{"name":"Model 6 correlation in SADA","default":-0.07,"unit":"correlation","category":"Table 3"},"model6_pi_noada_ada":{"name":"Model 6 πNOADA-ADA","default":0.03,"unit":"probability per observation transition","category":"Table 3"},"model6_pi_ada_noada":{"name":"Model 6 πADA-NOADA","default":0.003,"unit":"probability per observation transition","category":"Table 3"},"model6_mean_first_transition_day":{"name":"Model 6 predicted mean first SADA transition","default":63,"unit":"day","category":"Results text"},"observed_mean_first_clinical_ada_positive_day":{"name":"Observed mean first clinical ADA-positive measurement","default":81,"unit":"day","category":"Results text"},"clinical_ada_positive_threshold_u_ml":{"name":"Clinical ADA positive threshold","default":2.4,"unit":"U/mL","category":"Methods"},"ada_lloq_u_ml":{"name":"ADA assay LLOQ","default":0.6,"unit":"U/mL","category":"Methods"},"czp_lloq_ug_ml":{"name":"CZP assay LLOQ","default":0.41,"unit":"ug/mL","category":"Methods"},"study_count":{"name":"Clinical studies included","default":6,"unit":"studies","category":"Data"},"article_patients_n":{"name":"Patients reported in article Results","default":840,"unit":"patients","category":"Data"},"abstract_patients_n":{"name":"Patients reported in abstract","default":845,"unit":"patients","category":"Data"},"czp_measurements_n":{"name":"CZP plasma concentration measurements","default":6898,"unit":"measurements","category":"Data"},"ada_measurements_n":{"name":"ADA measurements","default":6557,"unit":"measurements","category":"Data"},"clinical_ada_positive_records_n":{"name":"Clinically positive ADA records","default":368,"unit":"records","category":"Data"},"clinical_ada_positive_records_fraction":{"name":"Clinically positive ADA records fraction","default":0.05,"unit":"fraction","category":"Data"},"model1_predicted_first_sada_day":{"name":"Model 1 predicted first SADA transition","default":85,"unit":"day","category":"Results text"},"model2_predicted_first_sada_day":{"name":"Model 2 predicted first SADA transition","default":78,"unit":"day","category":"Results text"},"model3_predicted_first_sada_day":{"name":"Model 3 predicted first SADA transition","default":83,"unit":"day","category":"Results text"},"model4_predicted_first_sada_day":{"name":"Model 4 predicted first SADA transition","default":64,"unit":"day","category":"Results text"},"model5_predicted_first_sada_day":{"name":"Model 5 predicted first SADA transition","default":84,"unit":"day","category":"Results text"},"univariate_pkres_pi_noada_ada":{"name":"Univariate PKRES πNOADA-ADA","default":0.05,"unit":"probability","category":"Table 4"},"univariate_pkres_pi_ada_noada":{"name":"Univariate PKRES πADA-NOADA","default":0.005,"unit":"probability","category":"Table 4"},"univariate_adames_pi_noada_ada":{"name":"Univariate ADAMES πNOADA-ADA","default":0.2,"unit":"probability","category":"Table 4"},"univariate_adames_pi_ada_noada":{"name":"Univariate ADAMES πADA-NOADA","default":1e-05,"unit":"probability","category":"Table 4"},"validation_run_nonce":{"name":"Validation run nonce","default":0,"unit":"dimensionless","category":"validation"}},"dosing_targets":{},"source":{"doi":"10.1007/s10928-023-09890-8","url":"https://doi.org/10.1007/s10928-023-09890-8","license":"CC BY 4.0","license_url":"https://creativecommons.org/licenses/by/4.0/","paper_title":"Brekkan 2024 certolizumab ADA bivariate hidden-Markov model"}}
