{"model_id":"qspquest-han-2026-sim2real-pk-daratumumab-tmdd","external_inputs":{},"definitions":{"d__weight_cl_factor":"(body_weight_kg / max(weight_reference_kg, 1.0e-12)) ** theta_weight_on_cl","d__albumin_cl_factor":"(albumin_g_l / max(albumin_reference_g_l, 1.0e-12)) ** theta_albumin_on_cl","d__tpmm_cl_factor":"1.0 + theta_tpmm_on_cl * max(tpmm_indicator, 0.0)","d__cl_l_model_time":"theta_cl_l_h * d__weight_cl_factor * d__albumin_cl_factor * d__tpmm_cl_factor","d__weight_v1_factor":"(body_weight_kg / max(weight_reference_kg, 1.0e-12)) ** theta_weight_on_v1","d__female_indicator":"1.0 - max(male_indicator, 0.0)","d__sex_v1_factor":"1.0 + theta_female_on_v1 * d__female_indicator","d__v1_l":"theta_v1_l * d__weight_v1_factor * d__sex_v1_factor","d__central_concentration_mg_l":"max(central_mg, 0.0) / max(d__v1_l, 1.0e-12)","d__peripheral_concentration_mg_l":"max(peripheral_mg, 0.0) / max(theta_v2_l, 1.0e-12)","d__vmax_t_mg_model_time":"theta_vm0_mg_h * exp(-theta_kdes_1_h * max(elapsed_day, 0.0))","d__linear_elimination_mg_model_time":"d__cl_l_model_time * d__central_concentration_mg_l","d__saturable_elimination_mg_model_time":"d__vmax_t_mg_model_time * max(central_mg, 0.0) / max(theta_km_mg_l + max(central_mg, 0.0), 1.0e-12)","d__central_to_peripheral_mg_model_time":"(theta_q_l_h / max(d__v1_l, 1.0e-12)) * max(central_mg, 0.0)","d__peripheral_to_central_mg_model_time":"(theta_q_l_h / max(theta_v2_l, 1.0e-12)) * max(peripheral_mg, 0.0)","d__daratumumab_f20_absolute_gain_pct":"paper_daratumumab_f20_finetuned_pct - paper_daratumumab_f20_baseline_pct","d__daratumumab_f20_relative_gain_pct":"100.0 * d__daratumumab_f20_absolute_gain_pct / max(paper_daratumumab_f20_baseline_pct, 1.0e-12)","d__ibrutinib_f50_absolute_gain_pct":"paper_ibrutinib_f50_finetuned_pct - paper_ibrutinib_f50_baseline_pct","d__single_dose_mg":"body_weight_kg * dose_mg_per_kg_for_reporting"},"equations":{"central_mg":"Dose_rate_ab - d__linear_elimination_mg_model_time - d__saturable_elimination_mg_model_time - d__central_to_peripheral_mg_model_time + d__peripheral_to_central_mg_model_time","peripheral_mg":"d__central_to_peripheral_mg_model_time - d__peripheral_to_central_mg_model_time","auc_mg_day_l":"d__central_concentration_mg_l","elapsed_day":"1.0"},"derived_outputs":{"central_concentration_mg_l":"d__central_concentration_mg_l","peripheral_concentration_mg_l":"d__peripheral_concentration_mg_l","cl_l_model_time":"d__cl_l_model_time","v1_l":"d__v1_l","vmax_t_mg_model_time":"d__vmax_t_mg_model_time","linear_elimination_mg_model_time":"d__linear_elimination_mg_model_time","saturable_elimination_mg_model_time":"d__saturable_elimination_mg_model_time","single_dose_mg":"d__single_dose_mg","daratumumab_f20_absolute_gain_pct":"d__daratumumab_f20_absolute_gain_pct","daratumumab_f20_relative_gain_pct":"d__daratumumab_f20_relative_gain_pct","ibrutinib_f50_absolute_gain_pct":"d__ibrutinib_f50_absolute_gain_pct"}}
