{"id":"qspquest-markovic-2024-vedolizumab-clearance-remission-poppk","version":"0.1.0","name":"Markovic 2024 Vedolizumab Clearance/Remission PopPK","description":"Two-compartment IV vedolizumab PopPK reconstruction from Markovic et al. 2024 Pharmaceutics. The model implements Table 2 fixed-effect parameters, the prior anti-TNF clearance covariate, standard induction/maintenance regimens, AUC accumulation, and paper endpoint overlays for Table 3.","time_unit":"day","states":{"A_central_mg":{"name":"Central vedolizumab amount","default":0.0,"unit":"mg","description":"Central compartment amount."},"A_peripheral_mg":{"name":"Peripheral vedolizumab amount","default":0.0,"unit":"mg","description":"Peripheral compartment amount."},"AUC_central_mg_day_L":{"name":"Central concentration AUC","default":0.0,"unit":"mg*day/L","description":"Running AUC of central concentration."}},"parameters":{"CL_L_day":{"name":"Clearance","default":0.159,"unit":"L/day","category":"paper parameter"},"Vc_L":{"name":"Central volume","default":3.19,"unit":"L","category":"paper parameter"},"Q_L_day":{"name":"Intercompartmental clearance","default":0.12,"unit":"L/day","category":"paper parameter"},"Vp_L":{"name":"Peripheral volume","default":1.66,"unit":"L","category":"paper parameter"},"ATNF_effect":{"name":"Prior anti-TNF clearance increase","default":0.264,"unit":"fraction","category":"paper parameter"},"prior_anti_tnf":{"name":"Prior anti-TNF indicator","default":0.0,"unit":"0/1","category":"scenario covariate"},"validation_run_nonce":{"name":"Validation run nonce","default":2026070801.0,"unit":"1","category":"validation"},"table2_CL_L_day":{"name":"Table 2 CL exact anchor","default":0.159,"unit":"L/day","category":"exact anchor"},"table2_Vc_L":{"name":"Table 2 Vc exact anchor","default":3.19,"unit":"L","category":"exact anchor"},"table2_Q_L_day":{"name":"Table 2 Q exact anchor","default":0.12,"unit":"L/day","category":"exact anchor"},"table2_Vp_L":{"name":"Table 2 Vp exact anchor","default":1.66,"unit":"L","category":"exact anchor"},"table2_IIV_CL_pct":{"name":"Table 2 IIV CL","default":16.4,"unit":"%","category":"exact anchor"},"table2_IIV_Vc_pct":{"name":"Table 2 IIV Vc","default":18.9,"unit":"%","category":"exact anchor"},"table2_residual_error":{"name":"Table 2 proportional residual error","default":0.458,"unit":"fraction","category":"exact anchor"},"table4_cl_threshold_L_day":{"name":"Table 4 CL threshold","default":0.1886,"unit":"L/day","category":"exact anchor"},"table4_cl_clinical_auroc_pct":{"name":"Table 4 CL clinical-remission AUROC","default":67.2,"unit":"%","category":"exact anchor"},"table4_cl_endoscopic_auroc_pct":{"name":"Table 4 CL endoscopic-remission AUROC","default":72.7,"unit":"%","category":"exact anchor"}},"dosing_targets":{"A_central_mg":1.0},"solver":{"method":"Rodas5P","abstol":1e-09,"reltol":1e-09,"maxiters":1000000},"source":{"doi":"10.3390/pharmaceutics16121629","url":"https://doi.org/10.3390/pharmaceutics16121629","license":"CC BY 4.0","license_url":"https://creativecommons.org/licenses/by/4.0/","paper_title":"Vedolizumab Clearance as a Surrogate Marker for Remission in Inflammatory Bowel Disease Patients: Insights from Real-World Pharmacokinetics."}}
