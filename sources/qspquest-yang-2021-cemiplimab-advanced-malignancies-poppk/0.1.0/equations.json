{"model_id":"qspquest-yang-2021-cemiplimab-advanced-malignancies-poppk","external_inputs":{},"definitions":{"time_term":"max(elapsed_time_day, 0.0)**hill_exponent / (T50_ind_day**hill_exponent + max(elapsed_time_day, 0.0)**hill_exponent)","clearance_time_factor":"exp(Emax_ind * time_term)","CL_ind_L_day":"TVCL_L_day * clearance_time_factor * (body_weight_kg/ref_body_weight_kg)**WGT_ON_CLQ * (albumin_g_L/ref_albumin_g_L)**ALB_ON_CLQ * (igg_g_L/ref_igg_g_L)**IGG_ON_CLQ * (alt_IU_L/ref_alt_IU_L)**ALT_ON_CLQ * exp(eta_clq)","Q_ind_L_day":"TVQ_L_day * (body_weight_kg/ref_body_weight_kg)**WGT_ON_CLQ * (albumin_g_L/ref_albumin_g_L)**ALB_ON_CLQ * (igg_g_L/ref_igg_g_L)**IGG_ON_CLQ * (alt_IU_L/ref_alt_IU_L)**ALT_ON_CLQ * exp(eta_clq)","V2_ind_L":"TVV2_L * (body_weight_kg/ref_body_weight_kg)**WGT_ON_VSS * (bmi_kg_m2/ref_bmi_kg_m2)**BMI_ON_VSS * exp(eta_vss)","V3_ind_L":"TVV3_L * (body_weight_kg/ref_body_weight_kg)**WGT_ON_VSS * (bmi_kg_m2/ref_bmi_kg_m2)**BMI_ON_VSS * exp(eta_vss)","central_conc_mg_L":"A_central_mg / V2_ind_L","peripheral_conc_mg_L":"A_peripheral_mg / V3_ind_L","elimination_mg_day":"CL_ind_L_day * central_conc_mg_L","distribution_to_peripheral_mg_day":"Q_ind_L_day * central_conc_mg_L","distribution_to_central_mg_day":"Q_ind_L_day * peripheral_conc_mg_L","dose_3mgkg_mg":"3.0 * body_weight_kg","T50_ind_day":"T50_day * exp(eta_t50)","Emax_ind":"Emax_clearance * exp(eta_emax)","vss_clearance_half_life_approx_day":"log(2.0) * (V2_ind_L + V3_ind_L) / CL_ind_L_day","rate_sum_per_day":"(CL_ind_L_day + Q_ind_L_day)/V2_ind_L + Q_ind_L_day/V3_ind_L","rate_product_per_day2":"CL_ind_L_day * Q_ind_L_day / (V2_ind_L * V3_ind_L)","frozen_terminal_rate_per_day":"2.0 * rate_product_per_day2 / (rate_sum_per_day + sqrt(max(rate_sum_per_day**2 - 4.0*rate_product_per_day2, 0.0)))","frozen_clearance_terminal_half_life_day":"log(2.0) / frozen_terminal_rate_per_day"},"equations":{"A_central_mg":"Dose_rate_ab - elimination_mg_day - distribution_to_peripheral_mg_day + distribution_to_central_mg_day","A_peripheral_mg":"distribution_to_peripheral_mg_day - distribution_to_central_mg_day","AUC_day_mg_L":"central_conc_mg_L","elapsed_time_day":"1.0"},"derived_outputs":{"central_conc_mg_L":"central_conc_mg_L","peripheral_conc_mg_L":"peripheral_conc_mg_L","CL_ind_L_day":"CL_ind_L_day","Q_ind_L_day":"Q_ind_L_day","V2_ind_L":"V2_ind_L","V3_ind_L":"V3_ind_L","clearance_time_factor":"clearance_time_factor","T50_ind_day":"T50_ind_day","Emax_ind":"Emax_ind","vss_clearance_half_life_approx_day":"vss_clearance_half_life_approx_day","frozen_clearance_terminal_half_life_day":"frozen_clearance_terminal_half_life_day","dose_3mgkg_mg":"dose_3mgkg_mg"}}
