{
  "definitions": {
    "CL_linear_L_day": "CL_ref_L_day * weight_ratio**theta_cl_weight",
    "CL_nonlinear_L_day": "(kint_1_day / Kss_ng_mL) * Vc_L * R_total_ss_ng_mL * (1.0 - C_unbound_ng_mL / (C_unbound_ng_mL + Kss_ng_mL))",
    "CL_total_L_day": "CL_linear_L_day + CL_nonlinear_L_day",
    "C_total_ng_mL": "max(A_total_central, 0.0) / Vc_L * 1000.0",
    "C_total_ug_mL": "C_total_ng_mL / 1000.0",
    "C_unbound_ng_mL": "max(0.0, 0.5*((C_total_ng_mL - R_total - Kss_ng_mL) + qss_radical))",
    "C_unbound_ug_mL": "C_unbound_ng_mL / 1000.0",
    "R_total_ss_ng_mL": "ksyn_ng_mL_day / kdeg_1_day",
    "Vc_L": "Vc_ref_L * weight_ratio**theta_vc_weight",
    "absorption_input_mg_day": "F_bioavailability * ka_1_day * A_depot",
    "bound_complex_ng_mL": "max(C_total_ng_mL - C_unbound_ng_mL, 0.0)",
    "cidbf_delta_dbf_PU": "baseline_dbf_PU * (1.0 - cidbf_inhibition_fraction)",
    "cidbf_inhibition_fraction": "Imax_fraction * C_unbound_ng_mL**hill_coefficient / (IC50_ng_mL**hill_coefficient + C_unbound_ng_mL**hill_coefficient)",
    "cidbf_inhibition_pct": "100.0 * cidbf_inhibition_fraction",
    "cidbf_inhibition_percent_of_imax": "cidbf_inhibition_pct / max(Imax_fraction, 1.0e-12)",
    "free_central_amount_mg": "C_unbound_ng_mL * Vc_L / 1000.0",
    "ic99_calculated_ng_mL": "IC50_ng_mL * 99.0**(1.0 / hill_coefficient)",
    "ka_half_life_calculated_day": "log(2.0) / ka_1_day",
    "kc0_1_day": "CL_linear_L_day / Vc_L",
    "kcp_1_day": "Q_L_day / Vc_L",
    "kpc_1_day": "Q_L_day / Vp_L",
    "max_nonlinear_clearance_calculated_L_day": "(kint_1_day / Kss_ng_mL) * Vc_ref_L * (ksyn_ng_mL_day / kdeg_1_day)",
    "qss_radical": "sqrt(max((C_total_ng_mL - R_total - Kss_ng_mL)**2 + 4.0*Kss_ng_mL*C_total_ng_mL, 0.0))",
    "weight_ratio": "max(body_weight_kg, 1.0) / reference_weight_kg"
  },
