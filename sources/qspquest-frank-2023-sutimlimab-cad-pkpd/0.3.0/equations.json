{
  "definitions": {
    "below_100_proxy_percent": "100.0 / (1.0 + exp((central_conc_ug_ml - target_trough_ug_ml) / 25.0))",
    "central_conc_ug_ml": "central_mg / max(vc_l_cov, 1e-12)",
    "cl_ml_h_cov": "table3_cl_ml_h * exp(log(body_weight_kg / reference_body_weight_kg) * table3_body_weight_on_cl_exponent)",
    "cp_activity_percent": "100.0 * (1.0 - exp(log(max(central_conc_ug_ml, 1e-12)) * cp_hill_factor) / max(exp(log(cp_ic50_ug_ml) * cp_hill_factor) + exp(log(max(central_conc_ug_ml, 1e-12)) * cp_hill_factor), 1e-12))",
    "distribution_mg_h": "table3_q_ml_h * (central_conc_ug_ml - peripheral_conc_ug_ml) / 1000.0",
    "drug_effect_fraction": "emax_fraction * central_conc_ug_ml / max(central_conc_ug_ml + table4_ec50_ug_ml, 1e-12)",
    "emax_fraction": "emax_no_transfusion_calc * (1.0 - blood_transfusion) + emax_transfusion_calc * blood_transfusion",
    "emax_no_transfusion_calc": "table4_emax_logit_parameter / (1.0 + table4_emax_logit_parameter)",
    "emax_transfusion_calc": "(table4_emax_logit_parameter * exp(table4_transfusion_effect_on_emax_logit)) / (1.0 + table4_emax_logit_parameter * exp(table4_transfusion_effect_on_emax_logit))",
    "hb0_cov_g_dl": "table4_hb0_g_dl * exp(log(clcr_ml_min / reference_clcr_ml_min) * table4_clcr_on_hb0_exponent)",
    "hb_change_g_dl": "hb_g_dl - hb0_cov_g_dl",
    "kin_g_dl_h": "hb0_cov_g_dl * kout_h_inv",
    "kout_h_inv": "1.0 / table4_turnover_time_h",
    "linear_clearance_mg_h": "cl_ml_h_cov * central_conc_ug_ml / 1000.0",
    "nonlinear_clearance_mg_h": "vmax_mg_h_cov * central_conc_ug_ml / max(table3_km_ug_ml + central_conc_ug_ml, 1e-12)",
    "peripheral_conc_ug_ml": "peripheral_mg / max(table3_vp_l, 1e-12)",
    "target_100_ratio": "central_conc_ug_ml / target_trough_ug_ml",
    "vc_l_cov": "table3_vc_l * exp(log(body_weight_kg / reference_body_weight_kg) * table3_body_weight_on_vc_exponent) * (1.0 - table3_japanese_effect_vc * is_japanese) * exp(log(age_year / reference_age_year) * table3_age_effect_vc)",
    "vmax_mg_h_cov": "table3_vmax_mg_h * (1.0 - table3_japanese_effect_vmax * is_japanese)"
  },
