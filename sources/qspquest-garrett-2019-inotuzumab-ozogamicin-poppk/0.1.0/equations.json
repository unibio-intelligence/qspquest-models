{"model_id":"qspquest-garrett-2019-inotuzumab-ozogamicin-poppk","external_inputs":{},"definitions":{"BBSA_safe_m2":"max(BBSA_m2, 1.0e-12)","BLSTPB_safe_pct":"max(BLSTPB_pct, 1.0e-12)","CL1_L_h":"CL1_base_L_h * (1.0 + theta_all_on_CL1 * ALL_indicator) * (BBSA_safe_m2 / reference_BBSA_m2)**theta_CL1_BBSA * (1.0 + theta_no_rituximab_on_CL1 * no_rituximab_indicator)","CL2_L_h":"CL2_base_L_h * (BBSA_safe_m2 / reference_BBSA_m2)**theta_CL2_BBSA","V1_L":"V1_base_L * (1.0 + theta_V1_BBSA * (BBSA_safe_m2 - reference_BBSA_m2))","KDES_1_h":"kdes_base_1_h * (1.0 + theta_all_on_kdes * ALL_indicator) * ifelse(BLSTPB_pct == -99.0, 1.0, (BLSTPB_safe_pct / reference_BLSTPB_pct)**theta_BLSTPB_on_kdes)","CLt_L_h":"CL2_L_h * exp(-KDES_1_h * elapsed_time_h)","CL_total_L_h":"CL1_L_h + CLt_L_h","K10_1_h":"CL_total_L_h / max(V1_L, 1.0e-12)","K12_1_h":"Q_L_h / max(V1_L, 1.0e-12)","K21_1_h":"Q_L_h / max(V2_L, 1.0e-12)","central_concentration_mg_L":"max(A_central_mg, 0.0) / max(V1_L, 1.0e-12)","central_concentration_ng_mL":"central_concentration_mg_L * 1000.0","peripheral_concentration_mg_L":"max(A_peripheral_mg, 0.0) / max(V2_L, 1.0e-12)","macro_sum_1_h":"K10_1_h + K12_1_h + K21_1_h","macro_discriminant":"sqrt(max(macro_sum_1_h**2 - 4.0 * K10_1_h * K21_1_h, 0.0))","alpha_1_h":"0.5 * (macro_sum_1_h + macro_discriminant)","beta_1_h":"0.5 * (macro_sum_1_h - macro_discriminant)","terminal_beta_half_life_h":"log(2.0) / max(beta_1_h, 1.0e-12)","low_BBSA_CL1_ratio":"(source_source_low_BBSA_m2 / reference_BBSA_m2)**theta_CL1_BBSA","low_BBSA_CL2_ratio":"(source_source_low_BBSA_m2 / reference_BBSA_m2)**theta_CL2_BBSA","low_BBSA_V1_ratio":"1.0 + theta_V1_BBSA * (source_source_low_BBSA_m2 - reference_BBSA_m2)","high_BBSA_CL1_ratio":"(source_source_high_BBSA_m2 / reference_BBSA_m2)**theta_CL1_BBSA","high_BBSA_CL2_ratio":"(source_source_high_BBSA_m2 / reference_BBSA_m2)**theta_CL2_BBSA","high_BBSA_V1_ratio":"1.0 + theta_V1_BBSA * (source_source_high_BBSA_m2 - reference_BBSA_m2)","kdes_half_time_h":"log(2.0) / max(KDES_1_h, 1.0e-12)","source_completeness_score":"(source_full_text_available + source_pdf_available + source_supplement_available) / 3.0"},"equations":{"A_central_mg":"Dose_rate_ab - K12_1_h * A_central_mg + K21_1_h * A_peripheral_mg - K10_1_h * A_central_mg","A_peripheral_mg":"K12_1_h * A_central_mg - K21_1_h * A_peripheral_mg","AUC_ng_h_mL":"central_concentration_ng_mL","elapsed_time_h":"1.0"},"derived_outputs":{"source_CL1_L_h":"source_CL1_L_h","source_CL1_ci_lower_L_h":"source_CL1_ci_lower_L_h","source_CL1_ci_upper_L_h":"source_CL1_ci_upper_L_h","source_CL1_bootstrap_median_L_h":"source_CL1_bootstrap_median_L_h","source_CL1_bootstrap_ci_lower_L_h":"source_CL1_bootstrap_ci_lower_L_h","source_CL1_bootstrap_ci_upper_L_h":"source_CL1_bootstrap_ci_upper_L_h","source_theta_all_on_CL1":"source_theta_all_on_CL1","source_theta_all_on_CL1_ci_lower":"source_theta_all_on_CL1_ci_lower","source_theta_all_on_CL1_ci_upper":"source_theta_all_on_CL1_ci_upper","source_theta_CL1_BBSA":"source_theta_CL1_BBSA","source_theta_CL1_BBSA_ci_lower":"source_theta_CL1_BBSA_ci_lower","source_theta_CL1_BBSA_ci_upper":"source_theta_CL1_BBSA_ci_upper","source_theta_no_rituximab_on_CL1":"source_theta_no_rituximab_on_CL1","source_theta_no_rituximab_on_CL1_ci_lower":"source_theta_no_rituximab_on_CL1_ci_lower","source_theta_no_rituximab_on_CL1_ci_upper":"source_theta_no_rituximab_on_CL1_ci_upper","source_CL2_L_h":"source_CL2_L_h","source_CL2_ci_lower_L_h":"source_CL2_ci_lower_L_h","source_CL2_ci_upper_L_h":"source_CL2_ci_upper_L_h","source_CL2_bootstrap_median_L_h":"source_CL2_bootstrap_median_L_h","source_CL2_bootstrap_ci_lower_L_h":"source_CL2_bootstrap_ci_lower_L_h","source_CL2_bootstrap_ci_upper_L_h":"source_CL2_bootstrap_ci_upper_L_h","source_theta_CL2_BBSA":"source_theta_CL2_BBSA","source_theta_CL2_BBSA_ci_lower":"source_theta_CL2_BBSA_ci_lower","source_theta_CL2_BBSA_ci_upper":"source_theta_CL2_BBSA_ci_upper","source_V1_L":"source_V1_L","source_V1_ci_lower_L":"source_V1_ci_lower_L","