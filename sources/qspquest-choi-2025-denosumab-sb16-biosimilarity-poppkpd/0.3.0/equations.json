{
  "definitions": {
    "Cfree_nM": "max(qss_difference_nM, 0.0) + 2.0 * kss_nM * Ctot_nM / max(qss_radical + abs(qss_difference_nM), 1.0e-300)",
    "Cperipheral_nM": "max(A_peripheral_free_nmol, 0.0) / max(vp_ind_L, 1.0e-12)",
    "Ctot_nM": "max(A_central_total_nmol, 0.0) / max(vc_ind_L, 1.0e-12)",
    "RC_nM": "max(0.0, RANKL_total_nM * Cfree_nM / max(kss_nM + Cfree_nM, 1.0e-12))",
    "Rfree_nM": "max(0.0, RANKL_total_nM - RC_nM)",
    "absorption_half_life_hv_day_runtime": "log(2.0) / ka_hv_h / 24.0",
    "absorption_half_life_pmo_day_runtime": "log(2.0) / ka_pmo_h / 24.0",
    "blq_postdose_fraction": "postdose_blq_samples / max(postdose_samples, 1.0e-12)",
    "bmd_change_percent": "100.0 * (lumbar_bmd_g_cm2 / max(bmd0_g_cm2, 1.0e-12) - 1.0)",
    "bmd_inhibition_fraction": "imax_fraction_runtime * Cfree_nM**hill_coeff / max(ic50_nM**hill_coeff + Cfree_nM**hill_coeff, 1.0e-12)",
    "cl_ind_L_h": "cl_apparent_L_h * weight_ratio**theta_weight_cl * treatment_cl_multiplier",
    "cl_ratio_runtime": "cl_sb16_L_h / max(cl_caucasian_L_h, 1.0e-12)",
    "cl_sb16_L_h": "cl_caucasian_L_h * treatment_cl_ratio_sb16_to_den",
    "dose_60mg_nmol_derived": "phase3_repeated_dose_mg * nmol_per_mg_denosumab",
    "imax_fraction_runtime": "exp(imax_f) / (1.0 + exp(imax_f))",
    "ka_ind_h": "ka_hv_h * (1.0 - population_pmo_flag) + ka_pmo_h * population_pmo_flag",
    "kin_bmd_runtime_g_cm2_h": "kout_bmd_h * bmd0_g_cm2",
    "ksyn_flux_nM_h": "r0_ind_nM * rankl_kdeg_h",
    "q_ind_L_h": "q_hv_L_h * (1.0 - population_pmo_flag) + q_pmo_L_h * population_pmo_flag",
    "qss_difference_nM": "Ctot_nM - RANKL_total_nM - kss_nM",
    "qss_radical": "sqrt(max((Ctot_nM - RANKL_total_nM - kss_nM)**2 + 4.0 * kss_nM * Ctot_nM, 0.0))",
    "quantifiable_postdose_fraction": "postdose_quantifiable_samples / max(postdose_samples, 1.0e-12)",
    "r0_ind_nM": "r0_hv_nM * (1.0 - population_pmo_flag) + r0_pmo_nM * population_pmo_flag",
    "rankl_kdeg_h": "ksyn_reported_nM_h / max(r0_ind_nM, 1.0e-12)",
    "steady_state_vd_runtime_L": "vc_f_L + vp_f_L",
    "vc_ind_L": "vc_f_L * weight_ratio**theta_weight_vc",
    "vp_ind_L": "vp_f_L * weight_ratio**theta_weight_vp",
    "weight_ratio": "max(body_weight_kg, 1.0e-12) / reference_weight_kg"
  },
