    "A_depot_nmol": "Dose_rate_ab - ka_ind_h * A_depot_nmol",
    "A_peripheral_free_nmol": "q_ind_L_h * (Cfree_nM - Cperipheral_nM)",
    "RANKL_total_nM": "ksyn_flux_nM_h - rankl_kdeg_h * RANKL_total_nM - (kint_h - rankl_kdeg_h) * RC_nM",
