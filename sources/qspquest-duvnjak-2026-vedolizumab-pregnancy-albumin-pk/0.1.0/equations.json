{"model_id":"qspquest-duvnjak-2026-vedolizumab-pregnancy-albumin-pk","external_inputs":{},"definitions":{"d__ga_week":"t + ga_offset_week","d__fa_week_raw":"d__ga_week - fa_offset_week","d__fa_week":"max(d__fa_week_raw, 0.0)","d__albumin_unclamped_g_l":"albumin_a * d__fa_week**2 + albumin_b * d__fa_week + albumin_c","d__albumin_g_l":"max(d__albumin_unclamped_g_l, 1.0e-9)","d__dalb_fraction":"(d__albumin_g_l - albumin_c) / max(albumin_c, 1.0e-9)","d__third_trimester_indicator":"max(0.0, (d__ga_week - 28.0) / max(abs(d__ga_week - 28.0), 1.0e-9))","d__albumin_cl_factor":"1.0 + pregnancy_albumin_effect_enabled * d__dalb_fraction * dalbcl","d__albumin_vc_factor":"1.0 + pregnancy_albumin_effect_enabled * d__dalb_fraction * dalbvc","d__t3ga_factor":"exp((d__ga_week / 28.0) * t3gacl * pregnancy_t3ga_effect_enabled * d__third_trimester_indicator)","d__pregeff_cl":"d__albumin_cl_factor * d__t3ga_factor","d__pregeff_vc":"d__albumin_vc_factor","d__baseline_cl_uc_l_day":"cl_uc_l_day * (body_weight_kg / 70.0)**wtcl * (albumin_c / 40.0)**albcl * (fcal_mg_kg / 700.0)**fcalcl * (partial_mayo / 6.0)**maycl * (age_year / 40.0)**agecl * tnfcl**prior_tnf_flag * adacl**ada_flag * azacl**aza_flag * mpcl**mp_flag * mtxcl**mtx_flag * aminocl**amino_flag","d__baseline_cl_cd_l_day":"cl_cd_l_day * (body_weight_kg / 70.0)**wtcl * (albumin_c / 40.0)**albcl * (fcal_mg_kg / 700.0)**fcalcl * (cdai / 300.0)**cdaicl * (age_year / 40.0)**agecl * tnfcl**prior_tnf_flag * adacl**ada_flag * azacl**aza_flag * mpcl**mp_flag * mtxcl**mtx_flag * aminocl**amino_flag","d__baseline_cl_l_day":"uc_flag * d__baseline_cl_uc_l_day + (1.0 - uc_flag) * d__baseline_cl_cd_l_day","d__baseline_vc_l":"vc_l * (body_weight_kg / 70.0)**wtvc * cdvc**cd_flag","d__cl_l_day":"d__baseline_cl_l_day * d__pregeff_cl","d__vc_l":"d__baseline_vc_l * d__pregeff_vc","d__vp_l":"vp_l * (body_weight_kg / 70.0)**wtvp","d__q_l_day":"q_l_day * (body_weight_kg / 70.0)**wtq","d__vmax_mg_day":"vmax_mg_day * (body_weight_kg / 70.0)**wtvmax","d__central_conc_mg_l":"max(central_mg, 0.0) / max(d__vc_l, 1.0e-9)","d__peripheral_conc_mg_l":"max(peripheral_mg, 0.0) / max(d__vp_l, 1.0e-9)","d__linear_elimination_mg_week":"7.0 * d__cl_l_day * d__central_conc_mg_l","d__nonlinear_elimination_mg_week":"7.0 * d__vmax_mg_day * d__central_conc_mg_l / max(km_mg_l + d__central_conc_mg_l, 1.0e-9)","d__distribution_mg_week":"7.0 * d__q_l_day * (d__central_conc_mg_l - d__peripheral_conc_mg_l)"},"equations":{"central_mg":"Dose_rate_ab - d__linear_elimination_mg_week - d__nonlinear_elimination_mg_week - d__distribution_mg_week","peripheral_mg":"d__distribution_mg_week","auc_mg_week_l":"d__central_conc_mg_l"},"derived_outputs":{}}
