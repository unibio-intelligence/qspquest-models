    "easi_base_tukey": "(baseline_easi_score + 1.0)**easi_lambda + easi_tcs_baseline*tcs_flag + easi_prior_baseline*prior_immunotherapy_flag + easi_age_baseline*age_delta_decade + easi_log_eos_baseline*log(eos_ratio) + easi_log_tarc_baseline*log(tarc_ratio)",
