    "iga_0_1_prob_approx": "1.0 / (1.0 + exp(-1.702 * iga_latent_le1))",
    "iga_base_q3": "iga_base_le3 + moderate_iga_flag * iga_moderate_baseline_shift",
    "iga_dslp_cov": "iga_dslp * weight_ratio**iga_weight_drug * (1.0 + asian_race*iga_asian_drug) * eos_ratio**iga_log_eos_drug * tarc_ratio**iga_log_tarc_drug",
    "iga_kout_day": "log(2.0) / iga_effect_half_life_day",
    "iga_latent_le1": "iga_q1 + iga_placebo + iga_dslp_cov * iga_response",
    "iga_placebo": "iga_pmax_cov * elapsed_day / max(iga_et50_day + elapsed_day, 1.0e-12)",
    "iga_pmax_cov": "iga_pmax * (1.0 + iga_age_pmax*age_delta_decade + iga_tcs_pmax*tcs_flag + iga_prior_pmax*prior_immunotherapy_flag + iga_moderate_pmax*moderate_iga_flag)",
    "iga_q0": "iga_q1 - exp(iga_beta_le0)",
    "iga_q1": "iga_q2 - exp(iga_beta_le1)",
    "iga_q2": "iga_base_q3 - exp(iga_beta_le2)",
    "ke_ind_day": "ke_day * bmi_ratio**ke_bmi_power * (1.0 + ada_positive * ke_ada_effect) * easi_ratio**ke_easi_power * (1.0 + white_race * ke_white_effect)",
    "ktr_day": "4.0 / max(mtt_day, 1.0e-12)",
    "linear_elim_mg_day": "ke_ind_day * central_mg",
    "nonlinear_elim_mg_day": "central_mg * vm_mg_l_day / max(km_mg_l + central_conc_mg_l, 1.0e-12)",
    "peripheral_conc_mg_l": "max(peripheral_mg, 0.0) / max(vp_ind_l, 1.0e-12)",
    "q_l_day": "k23_day * v2_ind_l",
    "tarc_ratio": "max(baseline_tarc_pg_ml, 1.0e-12) / reference_tarc_pg_ml",
    "v2_ind_l": "v2_l * weight_ratio**v2_weight_power * albumin_ratio**v2_albumin_power",
    "vp_ind_l": "v2_ind_l * k23_day / max(k32_day, 1.0e-12)",
