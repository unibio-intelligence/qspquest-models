    "d__iga_ratio": "max(iga_g_l / max(iga_ref_g_l, 1.0e-12), 1.0e-12)",
    "d__rtx_effect": "Emax * (d__A1_pos_mg ** hill_gamma) / (d__ed50_effective_mg ** hill_gamma + d__A1_pos_mg ** hill_gamma + 1.0e-30)"
  },
  "derived_outputs": {},
  "equations": {
    "A1_mg": "-Ke_day * A1_mg",
    "cd19_cells_ul": "Kin_cells_ul_day - Kout_day * (1.0 + d__rtx_effect) * cd19_cells_ul",
    "elapsed_day": "1.0"
  },
