{"id":"qspquest-zeng-2026-atezolizumab-software-poppk-simulation","version":"0.1.0","name":"Zeng 2026 atezolizumab PopPK software-comparison simulation","description":"Atezolizumab two-compartment PK with time-varying clearance, covariates and individual log-effects. Four table regimens, two additional figure control regimens and explicit source-code sensitivities. Typical trajectories do not reproduce population exposure summaries.","states":{"central_mg":{"name":"Central atezolizumab amount","default":0.0,"unit":"mg"},"peripheral_mg":{"name":"Peripheral atezolizumab amount","default":0.0,"unit":"mg"},"auc_ug_day_ml":{"name":"Atezolizumab concentration AUC","default":0.0,"unit":"ug*day/mL"},"elapsed_day":{"name":"Elapsed time","default":0.0,"unit":"day"}},"parameters":{"body_weight_kg":{"name":"Body weight","default":77.0,"unit":"kg","category":"source"},"albumin_g_l":{"name":"Baseline albumin","default":40.0,"unit":"g/L","category":"source"},"baseline_tumor_size_mm":{"name":"Baseline tumor size","default":63.0,"unit":"mm","category":"source"},"female_flag":{"name":"Female sex flag","default":0.0,"unit":"0/1","category":"source"},"atag_flag":{"name":"Anti-drug antibody flag","default":0.0,"unit":"0/1","category":"source"},"theta_cl_l_day":{"name":"typical CL","default":0.23,"unit":"L/day","category":"source"},"theta_vc_l":{"name":"central volume NONMEM/RxODE","default":3.25,"unit":"L","category":"source"},"theta_q_l_day":{"name":"intercompartmental clearance","default":0.603,"unit":"L/day","category":"source"},"theta_vp_l":{"name":"peripheral volume","default":2.88,"unit":"L","category":"source"},"theta_bw_cl":{"name":"body weight on CL","default":0.668,"unit":"power","category":"source"},"theta_alb_cl":{"name":"albumin on CL","default":-0.901,"unit":"power","category":"source"},"theta_bts_cl":{"name":"baseline tumor size on CL","default":0.116,"unit":"power","category":"source"},"theta_atag_cl":{"name":"anti-drug antibody effect on CL","default":1.158,"unit":"fact